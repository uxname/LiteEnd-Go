# Auth proxy for the admin dashboards. Every site below requires HTTP Basic
# Auth, so no dashboard is reachable anonymously.
#
# Credentials come from the environment (ADMIN_USER / ADMIN_PASSWORD_HASH),
# which docker-compose.yml always supplies — including the dev-only admin/admin
# fallback, which lives there rather than here because Caddy's `{$VAR:default}`
# only fires for an UNSET variable and compose sets every key it lists.
# To change the password, generate a new bcrypt hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpass'
# and set ADMIN_PASSWORD_HASH in the environment or .env (escape every $ as $$
# for docker compose).
{
	auto_https off
	admin off
}

(protected) {
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
}

# pgweb (DB browser)
:8081 {
	import protected
	reverse_proxy db_studio:8081
}

# RedisInsight
:8082 {
	import protected
	reverse_proxy redis_studio:5540
}

# Asynqmon (queue dashboard)
:8083 {
	import protected
	reverse_proxy asynqmon:8080
}
