# Application settings
# The port the server listens on locally (`task start:dev`) and the HOST port the dev
# docker-compose.yml publishes. Inside a container the server always listens on
# 4000, and the prod compose publishes NO host port at all: it joins the reverse
# proxy's network instead, so several copies can run side by side.
PORT=4000
# Environment. MUST be exactly "production" on a production deployment: that single
# value switches on all three hardenings at once — it refuses OIDC_MOCK_ENABLED,
# requires a non-empty CORS_ORIGIN, and disables GraphQL introspection and internal
# error messages. Anything else (including "staging") is treated as non-production.
NODE_ENV=development
# Comma-separated allowed origins; surrounding whitespace is trimmed. Include the SPA
# origin (e.g. http://localhost:3000) so the browser can call /graphql and /upload.
# This list ALSO authorizes the GraphQL WebSocket handshake, so a wrong entry silently
# refuses subscriptions from that origin. Empty = plain HTTP CORS allows any origin,
# but the WebSocket handshake then refuses EVERY cross-origin browser (and production
# refuses to boot) — set the list explicitly everywhere, including staging.
# "*" is NOT supported: it would allow every HTTP origin while refusing every browser
# WebSocket handshake (the pattern is matched against "scheme://host", and "*" does not
# match the "/" in it). List origins explicitly.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
LOG_LEVEL=info

# Docker image naming: registry prefix WITH trailing slash (e.g. ghcr.io/acme/);
# used by docker-compose*.yml and `task docker:build` / `task docker:push`.
#IMAGE_REGISTRY=ghcr.io/acme/
#IMAGE_TAG=latest
# Name of the EXTERNAL network the reverse proxy already runs on; the prod
# compose joins it instead of publishing a port (docker-compose.prod.yml).
#PROXY_NETWORK=dokploy-network

# Database configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
# Connection pool size of ONE replica. Sizing rule: replicas x DB_POOL_MAX must
# stay below the Postgres max_connections limit (default 100), leaving room for
# migrations, psql sessions and the dashboards.
DB_POOL_MAX=10

# Database browser (pgweb — zero-config, Prisma Studio analog)
DB_STUDIO_PORT=5100

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
# Redis browser (RedisInsight — pre-configures the connection via RI_REDIS_*)
REDIS_STUDIO_PORT=5200

# Number of reverse proxies in front of the app. The client address is taken this
# many entries from the RIGHT of X-Forwarded-For, so a client that forges the
# header cannot claim another address and get a fresh rate-limit bucket. Count the
# proxies you actually run: 1 for a single Caddy/nginx, 2 behind Cloudflare plus
# your own proxy. Too high a number trusts what the client wrote.
TRUSTED_PROXY_HOPS=1

# S3-compatible object storage for uploaded files. The dev docker-compose.yml
# runs a Garage for this and initializes it on `up` — layout, the key pair
# below and the bucket — so nothing here needs a manual command afterwards.
# S3_ENDPOINT is the S3 API address as the APP sees it: the values below suit an
# app started on the host (`task start:dev`); inside docker the compose file overrides
# it with http://garage:3900. Required — the app refuses to start without it.
S3_ENDPOINT=http://localhost:3900
# Garage insists on its own key format: "GK" + 24 hex chars for the id, 64 hex
# chars for the secret. These two are a working dev pair, fake on purpose;
# generate real ones with `openssl rand -hex 12` / `openssl rand -hex 32`.
S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_ACCESS_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
S3_BUCKET=uploads
# Set to true only when S3_ENDPOINT is https.
S3_USE_SSL=false
# Where the BROWSER downloads the files from: a file URL is S3_PUBLIC_BASE_URL +
# "/" + object key (a trailing slash here is stripped anyway). This is NOT
# S3_ENDPOINT — behind a reverse proxy it is your own domain, e.g.
# https://files.example.com/uploads.
#
# The right value depends on FILE_VISIBILITY below:
#   private — it must be <public S3 API address>/<bucket>, because a signed link
#             is exactly that plus the key, and the signature covers the host and
#             path. Against the dev Garage: its S3 API on 3900 plus the bucket.
#             The app refuses to start when this does not end in S3_BUCKET.
#   public  — it is the address that serves the bucket to anyone. Garage answers
#             anonymous S3-API requests with 403, so public files come off its WEB
#             endpoint on 3902, which picks the bucket from the HOST name
#             (garage-init aliases the bucket to that host) and reads the key from
#             the WHOLE path — so keep it path-less: http://localhost:3902
S3_PUBLIC_BASE_URL=http://localhost:3900/uploads

# How stored files reach a browser.
#   private (default) — nobody reads a file without a link signed by the API, and
#                       the link stops working after FILE_LINK_TTL_MINUTES. The
#                       bucket stays closed to anonymous readers.
#   public            — the bucket is world-readable and links never expire.
#                       Simpler and cacheable; anyone who ever sees a URL keeps
#                       access to that file forever. A deliberate choice, e.g.
#                       for avatars on a public profile page.
# Switching this alone is not enough on a running stack: `docker compose up -d`
# re-runs garage-init, which opens or closes the bucket to match.
FILE_VISIBILITY=private
# Lifetime of a signed link, in minutes (private mode only). Between 1 and 10080
# (7 days, the S3 signature limit). The link is a bearer token for that one file,
# so shorter is safer — but it has to outlive the page that shows the file, or
# the user gets a broken image: a cached page, a long lazily-loaded list and an
# idle tab are all longer than a few minutes. An hour covers those. Lower it when
# the files are worth more than the convenience, and see the rule about
# server-side rendering in docs/adr/0003.
FILE_LINK_TTL_MINUTES=60
# Shared secret between the Garage node and the initializer next to it in
# docker-compose.yml. Fake by design — that stack is loopback-only. Uncomment
# and set a real one (`openssl rand -hex 32`) for anything reachable.
#GARAGE_RPC_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# Asynqmon queue dashboard (Bull Board analog) — host port
ASYNQMON_PORT=5300

# Admin dashboards auth. ALL dashboards (pgweb, RedisInsight, Asynqmon) sit
# behind a Basic-Auth proxy, and the app's dev pages (/dev, /playground,
# /swagger) require the same credentials — no anonymous access.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# bcrypt hash of ADMIN_PASSWORD for the Caddy auth proxy.
# Generate your own: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# IMPORTANT: escape every $ as $$ so docker compose does not interpolate it.
# Leave this commented to fall back to the dev-only default in docker-compose.yml.
# Always set an explicit hash for any non-local deployment.
#ADMIN_PASSWORD_HASH=$$2a$$14$$REPLACE_WITH_YOUR_OWN_BCRYPT_HASH

# OIDC Configuration
# OIDC_AUDIENCE must match the `aud` claim of the token the SPA sends.
# Recommended (OAuth2-correct): register an API resource in Logto and send the
# access_token issued for it — then set OIDC_AUDIENCE to that resource indicator
# (e.g. http://localhost:4000) and point ISSUER/JWKS at your Logto endpoint:
#   OIDC_ISSUER=https://auth.uxna.me/oidc
#   OIDC_JWKS_URI=https://auth.uxna.me/oidc/jwks
#   OIDC_AUDIENCE=http://localhost:4000   # the Logto API resource identifier
#   OIDC_MOCK_ENABLED=false
# Nothing listens on localhost:3001 in this template — the two URLs below are
# placeholders: put your own tenant there (see docs/ENV-CONTRACT.md).
OIDC_ISSUER=http://localhost:3001/oidc
# App ID / Client ID (or API resource indicator — see note above)
OIDC_AUDIENCE=your-client-id
OIDC_JWKS_URI=http://localhost:3001/oidc/jwks

# Development mock OIDC user
# Set to "true" to bypass OIDC and use a hardcoded user with ADMIN and USER roles.
# WARNING: This should never be enabled in production.
OIDC_MOCK_ENABLED=true
